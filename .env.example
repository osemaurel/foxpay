# --- Front (Vite) -------------------------------------------------
# Ces deux valeurs sont publiques, elles finissent dans le bundle.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé publishable / anon>

# --- Edge Functions (supabase secrets set ...) --------------------
# Ne JAMAIS mettre ces valeurs dans un fichier .env du front.
#
# PAWAPAY_BASE_URL : https://api.sandbox.pawapay.io en test,
#                    https://api.pawapay.io en production.
# PAWAPAY_API_TOKEN : jeton d'API depuis le dashboard pawaPay.
# SITE_URL : URL publique du front, utilisée pour le returnUrl pawaPay
#            et pour les liens dans l'email. Pas de localhost : pawaPay
#            exige un domaine joignable depuis Internet.
# RESEND_API_KEY / RESEND_FROM : envoi de l'email de livraison.
#            RESEND_FROM doit être sur un domaine vérifié chez Resend.
